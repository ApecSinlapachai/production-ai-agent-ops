{
  "name": "01 - Agent Ops Webhook Intake & Dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ops-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000001",
      "name": "Webhook Intake Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "agent-ops-intake"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.AGENT_OPS_API_URL || 'http://localhost:8000') + '/webhooks/n8n' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.headers['idempotency-key'] || ('n8n-' + ($json.body.event_id || $execution.id)) }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  message: $json.body.message,\n  customer_ref: $json.body.customer_ref || null,\n  workflow_type: $json.body.workflow_type || 'customer_ops',\n  event_id: $json.body.event_id || $execution.id,\n  simulate_action_failure: Boolean($json.body.simulate_action_failure)\n} }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "Dispatch to Agent Ops API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_HEADER_AUTH_CREDENTIAL_ID",
          "name": "Agent Ops Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hitl-check-01",
              "leftValue": "={{ $json.requires_hitl }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "Requires HITL Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  status: 'pending_hitl_approval',\n  run_id: $json.id,\n  current_state: $json.current_state,\n  routing_tier: $json.routing_tier,\n  redacted_pii_count: $json.redaction_summary?.total_redacted ?? 0,\n  proposed_action: $json.proposed_action\n} }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "a1000001-0000-4000-8000-000000000004",
      "name": "Respond 202 HITL Pending",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  status: $json.current_state === 'DLQ' ? 'dead_lettered' : 'completed',\n  run_id: $json.id,\n  current_state: $json.current_state,\n  routing_tier: $json.routing_tier,\n  redacted_pii_count: $json.redaction_summary?.total_redacted ?? 0,\n  execution_result: $json.execution_result\n} }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1000001-0000-4000-8000-000000000005",
      "name": "Respond 200 Completed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  error: 'agent_api_error',\n  message: $json.error?.message ?? 'Agent Ops API request failed'\n} }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "a1000001-0000-4000-8000-000000000006",
      "name": "Respond 502 Upstream Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 460]
    }
  ],
  "connections": {
    "Webhook Intake Trigger": {
      "main": [
        [
          {
            "node": "Dispatch to Agent Ops API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch to Agent Ops API": {
      "main": [
        [
          {
            "node": "Requires HITL Approval?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 502 Upstream Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Requires HITL Approval?": {
      "main": [
        [
          {
            "node": "Respond 202 HITL Pending",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 200 Completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "production-ai-agent-ops"
    }
  ]
}
