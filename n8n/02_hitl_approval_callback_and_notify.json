{
  "name": "02 - Agent Ops HITL Approval Callback & Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ops-hitl-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000001",
      "name": "Webhook HITL Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "agent-ops-hitl-decision"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.AGENT_OPS_API_URL || 'http://localhost:8000') + '/api/v1/approvals/' + $json.body.approval_id + '/decision' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  decision: $json.body.decision,\n  decided_by: $json.body.decided_by || 'n8n.reviewer@demo',\n  decision_reason: $json.body.decision_reason || 'Submitted via n8n HITL callback'\n} }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b2000001-0000-4000-8000-000000000002",
      "name": "Submit HITL Decision to Agent API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_WITH_BEARER_AUTH_CREDENTIAL_ID",
          "name": "Agent Ops Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "completed-check-01",
              "leftValue": "={{ $json.run.current_state }}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000001-0000-4000-8000-000000000003",
      "name": "Run Executed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  status: 'approved_and_executed',\n  approval_id: $json.approval.id,\n  run_id: $json.run.id,\n  current_state: $json.run.current_state,\n  execution_result: $json.run.execution_result\n} }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2000001-0000-4000-8000-000000000004",
      "name": "Respond 200 Executed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 140]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  status: $json.approval.status === 'REJECTED' ? 'rejected_no_action' : 'attention_required',\n  approval_id: $json.approval.id,\n  run_id: $json.run.id,\n  current_state: $json.run.current_state,\n  error_message: $json.run.error_message\n} }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2000001-0000-4000-8000-000000000005",
      "name": "Respond 200 Rejected or Escalated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  error: 'agent_api_error',\n  message: $json.error?.message ?? 'HITL decision callback failed'\n} }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "b2000001-0000-4000-8000-000000000006",
      "name": "Respond 502 Upstream Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 460]
    }
  ],
  "connections": {
    "Webhook HITL Decision": {
      "main": [
        [
          {
            "node": "Submit HITL Decision to Agent API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit HITL Decision to Agent API": {
      "main": [
        [
          {
            "node": "Run Executed?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 502 Upstream Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Executed?": {
      "main": [
        [
          {
            "node": "Respond 200 Executed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 200 Rejected or Escalated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "production-ai-agent-ops"
    }
  ]
}
