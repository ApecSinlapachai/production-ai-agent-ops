# Database (Local Docker PostgreSQL 16 or Supabase Free Tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_ops

# Gemini API (Free Tier — Tiered Model Routing)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Security, Webhook & Public Demo Guardrails
AUTH_MODE=token # token | demo_sandbox
ADMIN_API_TOKEN=change-me-local-admin-token
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
CORS_ORIGINS=http://localhost:3000,https://your-demo.vercel.app
RATE_LIMIT_PER_MIN=15
RATE_LIMIT_PER_DAY=60

# Reliability & Execution Policy
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
HITL_CONFIDENCE_THRESHOLD=0.80

# Frontend (web/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
